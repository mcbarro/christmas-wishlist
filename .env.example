# Public, build-time Supabase configuration.
# Copy this file to .env.local and fill in your project values.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional deployment base path.
# Use "/" for custom domains and local development, or "/<repository-name>/"
# for GitHub Pages project sites. Defaults to "/".
VITE_BASE_PATH=/
